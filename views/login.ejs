<%- include('partials/header') %>

<link rel="stylesheet" href="/css/login.css">

<div class="login-page">
    <div class="login-left">
        <h1 class="brand-title">MobiShare</h1>
        <p class="brand-subtitle">Servizio di mobilità sostenibile</p>
    </div>

    <div class="login-form-container">
        <form action="/login" method="POST" class="login-form">
            <h2 class="login-title">Login</h2>
            <%- include('partials/error-box') %>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Username" required>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Password" required>
            </div>

            <button type="submit" class="login-button">Accedi</button>

            <div class="extra-links">
                <a href="/reset-password" class="forgot-password">Password dimenticata</a>
                <p>Non hai un account? <a href="/register">Registrati</a></p>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

