<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Fonts & CSS -->
<link rel="stylesheet" href="/css/compiti-tecnici.css">
<link href="https://fonts.googleapis.com/css2?family=Itim&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&display=swap" rel="stylesheet">

<main class="container mt-5 mb-5 flex-grow-1">
    <h1 class="page-title text-center mb-4">Compiti Tecnici</h1>

    <% if (mezziConDanni && mezziConDanni.length > 0) { %>
        <% mezziConDanni.forEach(mezzo => { %>
            <div class="card shadow rounded-4 p-4 mb-4">
                <h5 class="mb-3">
                    <strong>Mezzo #<%= mezzo.id %> - <%= mezzo.tipo || '' %></strong>
                </h5>
                <% if (mezzo.danni && mezzo.danni.length > 0) { %>
                    <ul class="list-group list-group-flush">
                        <% mezzo.danni.forEach(danno => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>Tipo danno:</strong> <%= danno.tipoDanno %><br>
                                    <strong>Parcheggio arrivo:</strong> <%= danno.parcheggio || '-' %><br>
                                    <strong>Segnalato da:</strong> <%= danno.segnalatoDa || '-' %><br>
                                    <strong>Data segnalazione:</strong>
                                    <%= danno.dataSegnalazione && danno.dataSegnalazione.toDate ? danno.dataSegnalazione.toDate().toLocaleString('it-IT') : '-' %>
                                </div>
                                <form method="POST" action="/danno-risolto" style="margin-left: 20px;">
                                    <input type="hidden" name="dannoId" value="<%= danno.id %>">
                                    <input type="hidden" name="mezzoId" value="<%= mezzo.id %>">
                                    <button type="submit" class="btn btn-success btn-sm">Risolto</button>
                                </form>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <em>Nessun danno segnalato per questo mezzo.</em>
                <% } %>
            </div>
        <% }) %>
    <% } else { %>
        <div class="alert alert-info text-center">
            Nessun mezzo con danni segnalati.
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>