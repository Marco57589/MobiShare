<%- include('partials/header') %>

<!-- Link al CSS dedicato -->
<link rel="stylesheet" href="/css/reset.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Itim&display=swap" rel="stylesheet">

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8 div-reset">
            <div class="card shadow">
                <div class="card-header text-center py-3">
                    <h2 class="title">Reimposta Password</h2>
                </div>
                <div class="card-body p-4">
                    <p class="mb-4">Inserisci il tuo indirizzo email. Riceverai un link per reimpostare la password.</p>
                    <form id="reset-form">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" required>
                        </div>
                        <div id="reset-error" class="alert alert-danger d-none"></div>
                        <div id="reset-success" class="alert alert-success d-none"></div>
                        <button type="submit" class="btn btn-primary">Invia Email di Reset</button>
                    </form>
                    <div class="text-center mt-3">
                        <p class="mb-0">Ricordi la password? <a href="/login">Accedi</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="module" src="/js/reset-password.js"></script>