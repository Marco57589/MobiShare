<%- include('partials/header') %>

<link rel="stylesheet" href="/css/register.css">

<div class="register-page">
    <div class="register-left">
        <h1 class="brand-title">MobiShare</h1>
        <h5 class="brand-subtitle">Servizio di mobilità sostenibile</h5>
    </div>
    <div class="register-form-container"> 
        <form action="/register" method="POST" class="register-form">
            <h2 class ="register-title">Registrati</h2>

            <div class="form-group">
                <label for="name" class="form-label">Nome completo</label>
                <input type="text" class="form-control <%= locals.errors && errors.name ? 'is-invalid' : '' %>" 
                    id="name" name="name" required value="<%= locals.formData ? formData.name : '' %>">
                <% if (locals.errors && errors.name) { %>
                    <div class="invalid-feedback"><%= errors.name %></div>
                <% } %>
            </div>
            <div class="form-group">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control <%= locals.errors && errors.email ? 'is-invalid' : '' %>" 
                    id="email" name="email" required value="<%= locals.formData ? formData.email : '' %>">
                <% if (locals.errors && errors.email) { %>
                    <div class="invalid-feedback"><%= errors.email %></div>
                <% } %>
            </div>
            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control <%= locals.errors && errors.password ? 'is-invalid' : '' %>" 
                    id="password" name="password" required minlength="8">
                <div class="form-text">La password deve contenere almeno 8 caratteri.</div>
                <% if (locals.errors && errors.password) { %>
                    <div class="invalid-feedback"><%= errors.password %></div>
                <% } %>
            </div>
            <div class="form-group">
                <label for="confirmPassword" class="form-label">Conferma Password</label>
                <input type="password" class="form-control <%= locals.errors && errors.confirmPassword ? 'is-invalid' : '' %>" 
                    id="confirmPassword" name="confirmPassword" required minlength="8">
                <% if (locals.errors && errors.confirmPassword) { %>
                    <div class="invalid-feedback"><%= errors.confirmPassword %></div>
                <% } %>
            </div>
            <% if (locals.generalError) { %>
                <div class="alert alert-danger"><%= generalError %></div>
            <% } %>
            <% if (locals.success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>
            
            <button type="submit" class="register-button">Registrati</button>
           
            <div class="text-center mt-3 extra-links">
                <p class="mb-0">Hai già un account? <a href="/login">Accedi</a></p>
            </div>
        </form>
    </div>
</div>


<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
